#include <stdio.h>
#include <stdlib.h>

// Structure for the hash map node
struct HashNode {
    int key;
    int value;
    struct HashNode* next;
};

// Simple Hash Map implementation
struct HashMap {
    int size;
    struct HashNode** buckets;
};

// Create a new hash map
struct HashMap* createMap(int size) {
    struct HashMap* map = (struct HashMap*)malloc(sizeof(struct HashMap));
    map->size = size;
    map->buckets = (struct HashNode**)calloc(size, sizeof(struct HashNode*));
    return map;
}

// Hash function handling negative keys
int hash(int key, int size) {
    long long abs_key = llabs((long long)key);
    return abs_key % size;
}

// Insert key-value pair into the map
void insert(struct HashMap* map, int key, int value) {
    int index = hash(key, map->size);
    struct HashNode* newNode = (struct HashNode*)malloc(sizeof(struct HashNode));
    newNode->key = key;
    newNode->value = value;
    newNode->next = map->buckets[index];
    map->buckets[index] = newNode;
}

// Search for a key in the map, returns index if found, -1 otherwise
int search(struct HashMap* map, int key) {
    int index = hash(key, map->size);
    struct HashNode* curr = map->buckets[index];
    while (curr != NULL) {
        if (curr->key == key) {
            return curr->value;
        }
        curr = curr->next;
    }
    return -1;
}

// Free the allocated memory for the hash map
void freeMap(struct HashMap* map) {
    for (int i = 0; i < map->size; i++) {
        struct HashNode* curr = map->buckets[i];
        while (curr != NULL) {
            struct HashNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(map->buckets);
    free(map);
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    // A bucket size roughly twice the number of items minimizes collisions
    int mapSize = numsSize * 2; 
    struct HashMap* map = createMap(mapSize);
    
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 0;

    for (int i = 0; i < numsSize; i++) {
        int complement = target - nums[i];
        int complementIndex = search(map, complement);
        
        // If complement is found in the hash map
        if (complementIndex != -1) {
            result[0] = complementIndex;
            result[1] = i;
            *returnSize = 2;
            break;
        }
        
        // Otherwise, store current number and its index
        insert(map, nums[i], i);
    }

    freeMap(map);
    return result;
}
